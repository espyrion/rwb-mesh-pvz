# Демо-значения без секретов: это публичные ключи стенда, а не реальные учётные данные.
# Скопируйте в .env при необходимости: cp .env.example .env
DATABASE_URL=sqlite:////data/mesh.db
MESH_PVZ_KEY=demo-pvz-key
MESH_SELLER_KEY=demo-seller-key
MESH_ADMIN_KEY=demo-admin-key
# Адрес API для скриптов (scripts/demo.py, scripts/simulate.py)
API_URL=http://localhost:8000
